# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In GitHub Actions, set these same names as repository secrets instead.

# Gmail account that receives the Booking.com notifications.
GMAIL_ADDRESS=you@gmail.com
# NOT your Google password: an App Password (16 chars, 2FA must be on).
# Create at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Notion integration token (starts with "ntn_" or "secret_") and the target
# database. The integration must be shared with that database.
NOTION_API_TOKEN=ntn_xxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Booking.com calendar export URL (Extranet > Rates & Availability > Sync calendars).
ICAL_URL=https://ical.booking.com/v1/export?t=xxxxxxxx

# --- Optional, with sensible defaults ---
# How notifications are found: "subject" (default) or "labels".
# Subject matching depends only on Booking.com's subject lines. Label mode reads
# the Gmail filter labels, which lets you curate scope by hand, but Gmail filters
# never apply retroactively -- run --audit-labels after any filter change.
# IMAP_SELECTION=subject
# IMAP_LABELS=Nieuwe boeking,Gewijzigde boeking,Geannuleerde boeking
# IMAP_FOLDER=          # default: auto-discover the All Mail folder
# LOOKBACK_DAYS=30
# DRY_RUN=false
